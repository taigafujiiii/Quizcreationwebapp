# ===========================================================================
# .env — プロジェクト設定テンプレート
# このファイルを .env にコピーして各自の値を埋めてください。
# .env は .gitignore で除外されています。絶対にコミットしないでください。
# ===========================================================================

# ---------------------------------------------------------------------------
# Supabase — フロントエンド (Vite)
# Project Settings > API > Project URL / anon public
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---------------------------------------------------------------------------
# Supabase — CLI (マイグレーション・Function デプロイ)
# SUPABASE_ACCESS_TOKEN : https://supabase.com/dashboard/account/tokens
# SUPABASE_PROJECT_REF  : Project Settings > General > Reference ID
# SUPABASE_DB_PASSWORD  : プロジェクト作成時に設定した DB パスワード
# ---------------------------------------------------------------------------
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_PROJECT_REF=xxxxxxxx
SUPABASE_DB_PASSWORD=your-db-password

# ---------------------------------------------------------------------------
# Supabase Edge Function の環境変数
# (npm run fn:env で一括セット)
# SUPABASE_SERVICE_ROLE_KEY : Project Settings > API > service_role secret
# INVITE_REDIRECT_URL       : 招待メールのリンク先 (/accept-invite)
# CORS_ORIGINS              : カンマ区切りで許可するオリジンを指定
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJ...
INVITE_REDIRECT_URL=https://your-app.vercel.app/accept-invite
CORS_ORIGINS=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# E2E テスト
# ---------------------------------------------------------------------------
E2E_BASE_URL=https://your-app.vercel.app
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=your-admin-password
E2E_USER_EMAIL=user@example.com
E2E_USER_PASSWORD=your-user-password
